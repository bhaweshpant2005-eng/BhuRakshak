# FastAPI
DEBUG=true
API_VERSION=v1
API_PREFIX=/api/v1
SECRET_KEY=change-this-local-development-key
ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# PostgreSQL/PostGIS (server-side only)
DATABASE_URL=postgresql+asyncpg://bhurakshak:bhurakshak-local@localhost:5432/bhurakshak
DATABASE_REQUIRED=true
AUTO_CREATE_SCHEMA=false
DEMO_MODE=true
SEED_DEMO_DATA=true
ANONYMOUS_DEMO_ACCESS=true
POSTGRES_DB=bhurakshak
POSTGRES_USER=bhurakshak
POSTGRES_PASSWORD=bhurakshak-local
POSTGRES_PORT=5432

# Local/object storage (server-side only)
OBJECT_STORAGE_PATH=.object-storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=bhurakshak-assets
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
MINIO_ROOT_USER=bhurakshak
MINIO_ROOT_PASSWORD=bhurakshak-local-only

# Public model/catalogue services
OPEN_METEO_ENABLED=true
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
CDSE_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional account credentials (server-side only)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
NASA_EARTHDATA_TOKEN=
CDS_API_KEY=
DATA_GOV_IN_API_KEY=
OPENAI_API_KEY=

# Restricted institutional connectors: only use authorized endpoints/credentials
IMD_API_URL=
IMD_API_KEY=
GSI_API_URL=
GSI_API_KEY=
INDIA_WRIS_API_URL=
INDIA_WRIS_API_KEY=
BHUVAN_API_URL=
BHUVAN_API_KEY=
MOSDAC_API_URL=
MOSDAC_API_KEY=

# Optional compatibility settings; not required for local persistence
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional external ML service
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT=30
